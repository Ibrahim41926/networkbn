<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barre_outils"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurfaceContainer" />

    <!-- V2 : le plan est affiché à l'échelle 1:1. La vue gère elle-même le défilement
         (mode Navigation) : aucune ScrollView ne doit ajouter un second décalage. -->
    <fr.istic.mob.networkBN.view.GrapheView
        android:id="@+id/vue_graphe"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
