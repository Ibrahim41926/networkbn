<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barre_outils"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurfaceContainer" />

    <!-- Le plan est affiché à l'échelle 1:1 : on défile s'il dépasse l'écran. -->
    <ScrollView
        android:id="@+id/defilement_vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <HorizontalScrollView
            android:id="@+id/defilement_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <fr.istic.mob.networkBN.view.GrapheView
                android:id="@+id/vue_graphe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </HorizontalScrollView>
    </ScrollView>

</LinearLayout>
